{
  "manifest_version": 3,
  "name": "UX Research Tracker",
  "version": "1.0.0",
  "description": "Injects a UX research tracking script into a selected website.",

  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}